# ─────────────────────────────────────────────────────────────
# BLANC Salon — environment variables
# With NONE of these set, the app runs in DEMO MODE with an
# embedded database, sample bookings and emails captured in the
# dashboard instead of being sent.
# ─────────────────────────────────────────────────────────────

# Postgres connection (Supabase: Project Settings → Database → Connection string,
# "Transaction pooler", port 6543). Setting this switches off demo mode.
DATABASE_URL=

# Random string, at least 32 characters. Setting it switches the site from DEMO to LIVE
# (no auto-loaded sample data, no demo login).
# e.g.  openssl rand -base64 48
SESSION_SECRET=

# Public URL of the site, used in email links (e.g. https://blancsalon.co.uk)
SITE_URL=

# Transactional email via Resend (https://resend.com). EMAIL_FROM must be on a verified domain.
RESEND_API_KEY=
EMAIL_FROM=

# Protects /api/cron (Vercel Cron sends it automatically as a Bearer token).
CRON_SECRET=

# Optional: Supabase Storage for treatment images (otherwise images are stored in the database).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGE_BUCKET=treatment-images

# Optional: demo-mode owner password (default "blanc-demo").
DEMO_ADMIN_PASSWORD=
# Optional: show the "demo preview" badge even when a real database is connected.
SHOW_DEMO_BANNER=
